#!/bin/bash
# ABOUTME: Challenge 04 Skip. Splices TODO 4a-4c and 5a-5b in from the Solution
# and nothing else, starts both Workers, and runs the starter so the decoupled
# run shows up in the Temporal UI.
set -euxo pipefail

WS=/root/workshop/nexus-decouple-monolith
workshop-solve "$WS/exercise" "$WS/solution" payments/workflows.go "TODO 4a" "TODO 4b" "TODO 4c"
workshop-solve "$WS/exercise" "$WS/solution" payments/worker.go "TODO 5a" "TODO 5b"

cd "$WS/exercise"
go vet ./...

pkill -f "compliance-worker" || true
pkill -f "payments-worker"   || true
sleep 1

nohup go run ./compliance-worker > /tmp/compliance-worker.log 2>&1 &
nohup go run ./payments-worker   > /tmp/payments-worker.log   2>&1 &
for i in $(seq 1 120); do
    grep -q "Compliance Worker started" /tmp/compliance-worker.log 2>/dev/null \
      && grep -q "Payments Worker started" /tmp/payments-worker.log 2>/dev/null && break
    sleep 1
done
grep -q "Compliance Worker started" /tmp/compliance-worker.log
grep -q "Payments Worker started" /tmp/payments-worker.log

# TXN-B parks for review, so the starter reports it as still running. That is
# the expected result, not a failure; challenge 05 resets it.
go run ./starter > /tmp/starter.log 2>&1
cat /tmp/starter.log
