#!/bin/bash
# ABOUTME: Observe-only Check (ADR 0003). Passes once 6 Failed ChainWorkflows exist
# in the local dev server (one five-level chain), which means the learner ran
# the Worker and `go run ./starter chain --fail`.
set -uo pipefail
fail() {
    if command -v fail-message >/dev/null 2>&1; then fail-message "$1"; else echo "FAIL: $1" >&2; fi
    exit 1
}

N=$(temporal workflow count --address 127.0.0.1:7233 \
    --query 'WorkflowType="ChainWorkflow" AND ExecutionStatus="Failed"' 2>/dev/null \
    | grep -oE '[0-9]+' | head -1)

if [ "${N:-0}" -lt 6 ]; then
    # `go run ./worker` runs a binary named `worker`.
    if ! pgrep -x worker >/dev/null; then
        fail "No five-level chain has failed yet, and no Worker is running. In the Worker tab, run 'go run ./worker'. Then in the Client tab, run 'go run ./starter chain --fail'."
    fi
    fail "No five-level chain has failed yet. In the Client tab, run: go run ./starter chain --fail"
fi
echo "PASS: a five-level chain failed at the bottom"
